---
interface Stat {
	value: string;
	label: string;
}

interface Props {
	stats: Stat[];
	note?: string;
}

const { stats, note } = Astro.props;
---

<section
	class="relative py-10 sm:py-12 md:py-14 px-5 sm:px-6 lg:px-8 bg-navy-light/30 border-y border-gold/10"
	data-section="proof"
	aria-label="Resultados em números"
>
	<div class="max-w-5xl mx-auto">
		<ul
			class="flex flex-wrap items-start justify-center gap-x-10 gap-y-8 sm:gap-x-14 list-none"
		>
			{
				stats.map((stat, index) => (
					<li
						class="text-center min-w-[8rem]"
						data-reveal="up"
						data-reveal-delay={String(Math.min(index + 1, 6))}
					>
						<span
							class="block font-serif font-bold text-4xl sm:text-5xl text-gradient-gold leading-none mb-2"
							data-countup
						>
							{stat.value}
						</span>
						<span class="block text-sm md:text-base text-muted leading-snug">
							{stat.label}
						</span>
					</li>
				))
			}
		</ul>

		{
			note && (
				<p
					class="text-center text-xs text-muted mt-7 max-w-2xl mx-auto leading-relaxed"
					data-reveal="up"
				>
					{note}
				</p>
			)
		}
	</div>
</section>
